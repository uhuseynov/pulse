generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique
  username          String    @unique
  displayName       String
  passwordHash      String
  /// Sessions that were issued before this moment are no longer accepted.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedServers           Server[]
  memberships            Member[]
  messages               Message[]
  sentFriendRequests     Friendship[]         @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]         @relation("FriendshipAddressee")
  conversationsAsA       Conversation[]       @relation("ConversationUserA")
  conversationsAsB       Conversation[]       @relation("ConversationUserB")
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

model Server {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  inviteCode String   @unique
  ownerId    String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  Member[]
  channels Channel[]

  @@map("servers")
}

model Member {
  id       String     @id @default(uuid(7)) @db.Uuid
  role     MemberRole @default(MEMBER)
  userId   String     @db.Uuid
  serverId String     @db.Uuid
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
  @@map("members")
}

model Channel {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String
  type      ChannelType @default(TEXT)
  serverId  String      @db.Uuid
  createdAt DateTime    @default(now())

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([serverId, name])
  @@map("channels")
}

/// A message belongs to exactly one place: a channel or a conversation.
model Message {
  id             String    @id @default(uuid(7)) @db.Uuid
  content        String
  channelId      String?   @db.Uuid
  conversationId String?   @db.Uuid
  authorId       String    @db.Uuid
  createdAt      DateTime  @default(now())
  editedAt       DateTime?

  channel      Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, id])
  @@index([conversationId, id])
  @@map("messages")
}

/// A friend request, and once accepted, the friendship itself.
model Friendship {
  id          String           @id @default(uuid(7)) @db.Uuid
  status      FriendshipStatus @default(PENDING)
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

/// A direct-message thread between two users. userAId is always the smaller
/// of the two ids, so each pair of users has exactly one conversation.
model Conversation {
  id            String   @id @default(uuid(7)) @db.Uuid
  userAId       String   @db.Uuid
  userBId       String   @db.Uuid
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("conversations")
}

/// A single-use link for choosing a new password. Only a hash of the token
/// is stored, so reading the database is not enough to use one.
model PasswordResetToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
