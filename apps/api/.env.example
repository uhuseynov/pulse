PORT=4000
# Where the web app runs. Several origins can be separated by commas.
WEB_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://pulse:pulse_dev_password@localhost:5432/pulse?schema=public"

# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Voice rooms (optional). Without all three, voice is turned off and the rest
# of the app still works. Create a project at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

REDIS_HOST=localhost
REDIS_PORT=6379
